# ─── Artefactos del modelo (Venta y Alquiler) ─────────────────────────────────
MODEL_PATH=models/xgboost_venta_v2.pkl
METADATA_PATH=data/features_metadata.json
CONFIG_PATH=config/model_config.json

MODEL_ALQUILER_PATH=models/xgboost_alquiler_v1.pkl
METADATA_ALQUILER_PATH=data/features_metadata_alquiler.json
CONFIG_ALQUILER_PATH=config/model_alquiler_config.json

MODELS_DIR=models

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Fuente única de datos del servicio:
#   - Inferencia: carga contexto distrital al startup (tabla distrito_anio_contexto)
#   - Reentrenamiento: lee dataset histórico (dataset_inmuebles_venta + JOIN)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inmobiliaria_ml_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ─── Administración ───────────────────────────────────────────────────────────
# Header requerido: X-Admin-Token para endpoints /api/v1/admin/
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=cambia_este_token_por_uno_seguro

# ─── Servidor ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Separar múltiples orígenes con comas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
