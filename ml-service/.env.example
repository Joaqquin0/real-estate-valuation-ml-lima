# ─── Rutas a artefactos del modelo ───────────────────────────────────────────
MODEL_PATH=../models/xgboost_venta_v2.pkl
METADATA_PATH=../data/features_metadata.json
CONTEXT_CSV_PATH=../data/distrito_contexto_ref.csv
CONFIG_PATH=./config/model_config.json

# ─── Data provider (fase 1: csv | fase 2: mongo) ─────────────────────────────
DATA_PROVIDER=csv

# ─── MongoDB (Fase 2 — no requerido en Fase 1) ───────────────────────────────
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=tasacion_db
# MONGO_COLLECTION_CONTEXTO=distrito_contexto

# ─── Servidor ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Separar múltiples orígenes con comas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
