# ─── Rutas a artefactos del modelo ───────────────────────────────────────────
MODEL_PATH=models/xgboost_venta_v2.pkl
METADATA_PATH=data/features_metadata.json
CONTEXT_CSV_PATH=data/distrito_contexto_ref.csv
CONFIG_PATH=config/model_config.json
MODELS_DIR=models

# ─── Data provider (fase 1: csv | fase 2: mongo) ─────────────────────────────
DATA_PROVIDER=csv

# ─── MongoDB (Fase 2 — no requerido en Fase 1) ───────────────────────────────
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=tasacion_db
# MONGO_COLLECTION_CONTEXTO=distrito_contexto

# ─── PostgreSQL (reentrenamiento desde inmobiliaria_ml_db) ───────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inmobiliaria_ml_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ─── Administración (token para endpoint de reentrenamiento) ─────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=cambia_este_token_por_uno_seguro

# ─── Servidor ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Separar múltiples orígenes con comas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
